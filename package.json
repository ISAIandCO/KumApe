{
  "name": "kumape",
  "version": "0.3.12",
  "private": true,
  "description": "Firefox investigation companion for Kaspersky KUMA",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/with-core.mjs node --test",
    "build": "node scripts/with-core.mjs node scripts/build.mjs",
    "build:self-hosted": "node scripts/with-core.mjs npm run build:self-hosted:resolved",
    "package": "node scripts/with-core.mjs node scripts/package.mjs",
    "check:reproducible": "node scripts/with-core.mjs node scripts/check-reproducible.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "core:check": "node scripts/with-core.mjs node scripts/check-core.mjs",
    "test:core": "node scripts/with-core.mjs node --test scripts/core-contracts.mjs scripts/core-resolution-contracts.mjs",
    "build:self-hosted:resolved": "npm test && node scripts/build.mjs --self-hosted && npm run verify:release",
    "core:prepare": "node scripts/with-core.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "apeShareCore": {
    "major": 1
  }
}
