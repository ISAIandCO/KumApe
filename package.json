{
  "name": "kumape",
  "version": "0.3.11",
  "private": true,
  "description": "Firefox investigation companion for Kaspersky KUMA",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "build:self-hosted": "npm test && node scripts/build.mjs --self-hosted && npm run verify:release",
    "package": "node scripts/package.mjs",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "core:check": "node scripts/check-core.mjs",
    "test:core": "node --test scripts/core-contracts.mjs scripts/core-update-contracts.mjs",
    "core:update": "node scripts/update-core.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@isaiandco/ape-share-core": "https://codeload.github.com/ISAIandCO/ApeShareCore/tar.gz/d15097c34c49a90525c5cbe174566a59d34927a0"
  }
}
